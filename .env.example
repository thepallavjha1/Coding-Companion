# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM model name (recommended: llama-3.3-70b-versatile or llama-3.1-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model for vector code search (runs locally via HuggingFace - free and no extra API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum self-healing / refinement iterations before stopping
MAX_ITERATIONS=5
